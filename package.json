{
  "name": "amberchest",
  "version": "2.1.0",
  "private": true,
  "description": "AmberChest - IMAP mail backup in plain .eml files",
  "license": "AGPL-3.0-or-later",
  "author": "sphings79",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/web",
    "packages/desktop"
  ],
  "scripts": {
    "build": "pnpm --filter @amberchest/core build && pnpm --filter @amberchest/server build && pnpm --filter @amberchest/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "dev": "pnpm --filter @amberchest/web dev",
    "dev:server": "pnpm --filter @amberchest/server dev",
    "dev:web": "pnpm --filter @amberchest/web dev"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.19.0"
}
